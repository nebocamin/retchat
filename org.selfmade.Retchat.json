{
    "app-id": "org.selfmade.Retchat",
    "runtime": "org.gnome.Platform",
    "runtime-version": "50",
    "sdk": "org.gnome.Sdk",
    "command": "retchat",
    "finish-args": [
        "--share=network",
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=all",
        "--filesystem=home",
        "--talk-name=org.freedesktop.Notifications"
    ],
    "modules": [
        {
            "name": "python-dependencies",
            "buildsystem": "simple",
            "build-options": {
                "build-args": ["--share=network"]
            },
            "sources": [
                {
                    "type": "file",
                    "path": "requirements.txt"
                }
            ],
            "build-commands": [
                "pip3 install --prefix=/app --no-deps --no-cache-dir --only-binary=:all: -r requirements.txt"
            ]
        },
        {
            "name": "retchat",
            "buildsystem": "simple",
            "sources": [
                {
                    "type": "dir",
                    "path": ".",
                    "skip": [
                        ".git",
                        ".venv",
                        ".flatpak-builder",
                        ".flatpak-build",
                        ".flatpak-repo",
                        ".flatpak-build-aarch64",
                        ".flatpak-repo-aarch64",
                        ".wheels-aarch64",
                        ".pytest_cache",
                        "retchat.flatpak",
                        "retchat-aarch64.flatpak"
                    ]
                }
            ],
            "build-commands": [
                "pip3 install --no-build-isolation --no-deps --prefix=/app .",
                "install -Dm644 org.selfmade.Retchat.desktop /app/share/applications/org.selfmade.Retchat.desktop",
                "install -Dm644 data/icons/hicolor/scalable/apps/org.selfmade.Retchat.svg /app/share/icons/hicolor/scalable/apps/org.selfmade.Retchat.svg",
                "install -Dm644 data/icons/hicolor/symbolic/apps/org.selfmade.Retchat-symbolic.svg /app/share/icons/hicolor/symbolic/apps/org.selfmade.Retchat-symbolic.svg",
                "install -Dm644 data/icons/hicolor/symbolic/apps/org.selfmade.Retchat-globe-symbolic.svg /app/share/icons/hicolor/symbolic/apps/org.selfmade.Retchat-globe-symbolic.svg",
                "install -Dm644 org.selfmade.Retchat.metainfo.xml /app/share/metainfo/org.selfmade.Retchat.metainfo.xml"
            ]
        }
    ]
}
