<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>org.selfmade.Retchat</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Retchat</name>
  <developer id="org.selfmade">
    <name>stereo</name>
  </developer>
  <url type="homepage">https://github.com/nebocamin/retchat</url>
  <url type="vcs-browser">https://github.com/nebocamin/retchat</url>
  <content_rating type="oars-1.1">
    <content_attribute id="social-chat">intense</content_attribute>
  </content_rating>
  <summary>Dezentraler Reticulum LXMF Chat für Desktop und Phosh-Mobilgeräte</summary>
  <description>
    <p>
      Retchat ist ein moderner Chat-Client für das Reticulum Network im GTK4/Libadwaita-Stil,
      optimiert für Desktop und mobile Linux-Geräte (z.B. postmarketOS mit Phosh).
    </p>
    <p>
      Funktionen umfassen Ende-zu-Ende-Verschlüsselung per LXMF, Peer-Entdeckung im Mesh über
      Announces, Schnittstellenübersicht (TCP, LoRa RNode) und konfigurierbare Identitäten.
    </p>
  </description>
  <launchable type="desktop-id">org.selfmade.Retchat.desktop</launchable>
  <icon type="stock">org.selfmade.Retchat</icon>
  <branding>
    <color type="primary" scheme_preference="light">#99c1f1</color>
    <color type="primary" scheme_preference="dark">#1a5fb4</color>
  </branding>
  <provides>
    <binary>retchat</binary>
  </provides>
  <categories>
    <category>Network</category>
    <category>Chat</category>
    <category>InstantMessaging</category>
  </categories>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
    <control>touch</control>
  </supports>
</component>
